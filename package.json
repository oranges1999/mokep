{
  "name": "mokep",
  "displayName": "Mokep",
  "description": "Read-only viewer for .pen design files, driven by an agent over MCP.",
  "version": "0.2.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/oranges1999/mokep.git"
  },
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mokep.pen",
        "displayName": "Mokep",
        "selector": [
          {
            "filenamePattern": "*.pen"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "mokep.copyMcpCommand",
        "title": "Mokep: Copy MCP setup command"
      },
      {
        "command": "mokep.setupMcp",
        "title": "Mokep: Set up MCP for Claude Code"
      },
      {
        "command": "mokep.goToFrame",
        "title": "Mokep: Go to frame"
      },
      {
        "command": "mokep.lint",
        "title": "Mokep: Lint open file"
      },
      {
        "command": "mokep.newFile",
        "title": "Mokep: New design file",
        "icon": "$(new-file)"
      },
      {
        "command": "mokep.openFile",
        "title": "Mokep: Open design file",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mokep.openRecent",
        "title": "Mokep: Open recent design"
      },
      {
        "command": "mokep.removeRecent",
        "title": "Remove from recent designs",
        "icon": "$(close)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mokep",
          "title": "Mokep",
          "icon": "media/mokep.svg"
        }
      ]
    },
    "views": {
      "mokep": [
        {
          "id": "mokep.files",
          "name": "Recent designs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mokep.files",
        "contents": "No designs opened yet.\n[New design file](command:mokep.newFile)\n[Open design file](command:mokep.openFile)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mokep.newFile",
          "when": "view == mokep.files",
          "group": "navigation@1"
        },
        {
          "command": "mokep.openFile",
          "when": "view == mokep.files",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mokep.removeRecent",
          "when": "view == mokep.files && viewItem == mokep.recent",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "mokep.openRecent",
          "when": "false"
        },
        {
          "command": "mokep.removeRecent",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies --skip-license",
    "assets": "node scripts/fetch-fonts.mjs && node scripts/fetch-icons.mjs",
    "fixture": "node scripts/make-fixture.mjs && node scripts/make-test-image.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pixi.js": "^8.22.0",
    "ws": "^8.22.1",
    "yoga-layout": "^3.2.1",
    "zod": "^4.6.7"
  }
}
